{
  "manifest_version": 3,
  "name": "X Digest",
  "version": "0.2.0",
  "minimum_chrome_version": "116",
  "description": "X 视频字幕、双语翻译、AI 概览、选文讲解与时间戳笔记。",
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://api.supadata.ai/*",
    "https://api.deepseek.com/*"
  ],
  "action": {
    "default_title": "Open X Digest",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": [
        "x-video.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}